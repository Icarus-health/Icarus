# Icarus — lokale Konfiguration
#
#   cp .env.example .env
#
# Danach mindestens POSTGRES_PASSWORD und einen LLM-Key setzen.
# Diese Datei ist eine Vorlage und enthält keine echten Secrets.
# .env selbst ist in .gitignore und darf niemals committet werden.

# ---------------------------------------------------------------------------
# LLM- und Embedding-Anbieter
# ---------------------------------------------------------------------------
# Mem0 braucht ein Modell, um aus Gesprächen Fakten zu extrahieren, und ein
# Embedding-Modell für die Vektorsuche. Ohne Key startet der Server zwar,
# aber das Anlegen von Memories schlägt fehl.
#
# Hinweis zu Säule 2 (Anbieterunabhängigkeit): dieser Key bestimmt nur, WER
# extrahiert und einbettet. Die Daten selbst liegen im eigenen Postgres.
OPENAI_API_KEY=

# Optional — im Mem0-Server-Image ebenfalls mitgeliefert.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Default-Modelle. Der Anbieter muss zu den im Image gebündelten passen.
MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Postgres / pgvector
# ---------------------------------------------------------------------------
# POSTGRES_HOST/PORT gelten für Tools außerhalb von Compose. Innerhalb des
# Compose-Netzes überschreibt docker-compose.yml den Host auf "postgres".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# PFLICHT. Ohne Wert startet der Stack nicht.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Collection für die Vektoreinträge in der Default-Datenbank.
POSTGRES_COLLECTION_NAME=memories

# Getrennte Anwendungsdatenbank für Nutzer, Auth und API-Keys.
# Wird von docker/postgres/init-db.sh beim ersten Start angelegt.
APP_DB_NAME=mem0_app

# ---------------------------------------------------------------------------
# Mem0 Auth
# ---------------------------------------------------------------------------
# Secret für die Signatur der Session-Tokens.
#   openssl rand -hex 32
JWT_SECRET=

# Wird beim Bootstrap gesetzt bzw. erzeugt; siehe `make bootstrap-hinweis`.
ADMIN_API_KEY=

# Nur für lokale Entwicklung auf true setzen. In jedem anderen Fall false
# lassen — sonst ist die Memory-API ohne Authentifizierung erreichbar.
AUTH_DISABLED=false

# URL, unter der das optionale Mem0-Dashboard erreichbar ist (Profil "dashboard").
# Bewusst 3001: Port 3000 gehört Open WebUI.
DASHBOARD_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Telemetrie
# ---------------------------------------------------------------------------
# Mem0 sendet per Default ein anonymes Onboarding-Event. Für ein System, dessen
# Zweck die Hoheit über die eigenen Daten ist, ist der richtige Default aus.
MEM0_TELEMETRY=false

# ---------------------------------------------------------------------------
# Host-Ports
# ---------------------------------------------------------------------------
OPEN_WEBUI_HOST_PORT=3000
MEM0_HOST_PORT=8888
MEM0_DASHBOARD_HOST_PORT=3001
# POSTGRES_HOST_PORT=8432

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
# Authentifizierung der Oberfläche. Nur abschalten, wenn der Stack ausschließlich
# lokal und auf einem Einzelplatzrechner läuft.
WEBUI_AUTH=true
