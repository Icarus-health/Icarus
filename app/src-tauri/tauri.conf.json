{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icarus",
  "version": "0.1.0",
  "identifier": "health.icarus.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Icarus",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Productivity",
    "icon": ["icons/icon.png"],
    "shortDescription": "Persönliches KI-Betriebssystem",
    "resources": ["binaries/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
